{
  "groups": [
    {
      "name": "taptouch-receiving-integration",
      "code_patterns": [
        "app/domain/document_sources.py",
        "app/domain/taptouch_receiving.py",
        "app/services/taptouch_receiving_import_service.py",
        "app/infra/postgres_taptouch_receiving_repository.py",
        "app/api/integration_auth.py",
        "app/api/taptouch_integration_routes.py"
      ],
      "documents": [
        "docs/product.md",
        "docs/architecture.md"
      ]
    },
    {
      "name": "document-lifecycle-and-worker",
      "code_patterns": [
        "app/domain/extraction_*.py",
        "app/services/document_upload_service.py",
        "app/services/extraction_service.py",
        "app/workers/**",
        "app/infra/postgres_extraction_run_repository.py"
      ],
      "documents": [
        "docs/architecture.md",
        "docs/ai.md",
        "docs/development.md"
      ]
    },
    {
      "name": "review-and-versioning",
      "code_patterns": [
        "app/domain/document_drafts.py",
        "app/domain/document_versions.py",
        "app/services/review_service.py",
        "app/infra/postgres_review_repository.py",
        "frontend/src/review/**"
      ],
      "documents": [
        "docs/product.md",
        "docs/architecture.md"
      ]
    },
    {
      "name": "validation-rules",
      "code_patterns": [
        "app/domain/validation.py",
        "app/services/validation_service.py"
      ],
      "documents": [
        "docs/product.md",
        "docs/ai.md"
      ]
    },
    {
      "name": "reconciliation",
      "code_patterns": [
        "app/domain/reconciliation*.py",
        "app/domain/reconciliation_cases.py",
        "app/services/candidate_matching_service.py",
        "app/services/reconciliation*.py",
        "app/infra/postgres_reconciliation_repository.py",
        "app/infra/postgres_reconciliation_case_repository.py",
        "app/domain/workspace.py",
        "app/services/workspace_*.py",
        "app/infra/postgres_workspace_repository.py",
        "frontend/src/reconcile/**",
        "frontend/src/cases/**",
        "frontend/src/workspace/**"
      ],
      "documents": [
        "docs/product.md",
        "docs/architecture.md"
      ]
    },
    {
      "name": "model-and-evaluation",
      "code_patterns": [
        "app/domain/normalization.py",
        "app/domain/parsing.py",
        "app/infra/mineru_parser.py",
        "app/infra/openai_normalization_provider.py",
        "app/resources/prompts/**",
        "app/evaluation/**",
        "app/experiments/**",
        "app/cli/evaluate_extraction.py",
        "app/cli/compare_evaluations.py",
        "app/cli/create_experiment.py",
        "app/cli/run_experiment.py",
        "tools/generate_evaluation_dataset.py",
        "tools/validate_evaluation_dataset.py"
      ],
      "documents": [
        "docs/ai.md"
      ]
    },
    {
      "name": "data-and-infrastructure",
      "code_patterns": [
        "app/infra/database*.py",
        "app/infra/minio_storage.py",
        "migrations/**"
      ],
      "documents": [
        "docs/architecture.md",
        "docs/development.md"
      ]
    },
    {
      "name": "api-ui-and-operations",
      "code_patterns": [
        "app/api/**",
        "app/main.py",
        "app/core/config.py",
        "app/services/auth_service.py",
        "app/services/runtime_status_service.py",
        "frontend/src/**",
        "scripts/**",
        "run_api.py",
        "run_extraction_worker.py",
        "run_workspace_worker.py",
        "run_local_demo.py",
        "setup_dev_admin.py",
        "setup_demo_data.py",
        "start_local_demo.ps1",
        "stop_local_demo.ps1",
        ".env.example"
      ],
      "documents": [
        "docs/development.md",
        "docs/architecture.md"
      ]
    },
    {
      "name": "ci-cd-and-delivery",
      "code_patterns": [
        ".github/**",
        "Dockerfile",
        "frontend/Dockerfile",
        "frontend/nginx.conf",
        ".dockerignore",
        "frontend/.dockerignore",
        "compose*.yaml",
        ".env.compose.example",
        "tools/smoke_compose.py"
      ],
      "documents": [
        "docs/development.md"
      ]
    },
    {
      "name": "frozen-task-harness",
      "code_patterns": [
        "tools/check_task_scope.py",
        "tools/check_spec_contract.py",
        "tests/test_harness_guards.py"
      ],
      "documents": [
        "docs/development.md",
        "spec/06-harness.md"
      ]
    }
  ]
}
