{
  "groups": [
    {
      "name": "document-lifecycle-and-worker",
      "code_patterns": [
        "app/domain/extraction_*.py",
        "app/services/document_upload_service.py",
        "app/services/extraction_service.py",
        "app/workers/**",
        "app/infra/postgres_extraction_run_repository.py"
      ],
      "documents": [
        "docs/business/03-document-lifecycle.md",
        "docs/ai/04-extraction-pipeline.md",
        "docs/operations/08-api-ui-and-local-run.md",
        "docs/architecture/14-source-code-walkthrough.md",
        "docs/architecture/decisions/0002-postgresql-backed-worker-queue.md",
        "docs/interview/17-code-reading-exercises.md"
      ]
    },
    {
      "name": "review-and-versioning",
      "code_patterns": [
        "app/domain/document_drafts.py",
        "app/domain/document_versions.py",
        "app/services/review_service.py",
        "app/infra/postgres_review_repository.py",
        "frontend/src/review/**"
      ],
      "documents": [
        "docs/business/05-review-and-versioning.md",
        "docs/reference/11-api-contracts.md",
        "docs/architecture/decisions/0003-human-approved-immutable-versions.md",
        "docs/interview/17-code-reading-exercises.md"
      ]
    },
    {
      "name": "validation-rules",
      "code_patterns": [
        "app/domain/validation.py",
        "app/services/validation_service.py"
      ],
      "documents": [
        "docs/business/05-review-and-versioning.md",
        "docs/operations/13-error-codes-and-troubleshooting.md"
      ]
    },
    {
      "name": "reconciliation",
      "code_patterns": [
        "app/domain/reconciliation*.py",
        "app/services/candidate_matching_service.py",
        "app/services/reconciliation*.py",
        "app/infra/postgres_reconciliation_repository.py",
        "frontend/src/reconcile/**"
      ],
      "documents": [
        "docs/business/06-reconciliation-rules.md",
        "docs/architecture/14-source-code-walkthrough.md",
        "docs/architecture/decisions/0004-deterministic-reconciliation.md",
        "docs/tutorial/16-end-to-end-worked-example.md",
        "docs/interview/17-code-reading-exercises.md"
      ]
    },
    {
      "name": "model-and-evaluation",
      "code_patterns": [
        "app/domain/normalization.py",
        "app/domain/parsing.py",
        "app/infra/mineru_parser.py",
        "app/infra/openai_normalization_provider.py",
        "app/resources/prompts/**",
        "app/evaluation/**",
        "app/cli/evaluate_extraction.py",
        "app/cli/compare_evaluations.py",
        "tools/generate_evaluation_dataset.py",
        "tools/validate_evaluation_dataset.py"
      ],
      "documents": [
        "docs/ai/04-extraction-pipeline.md",
        "docs/ai/09-testing-and-evaluation.md",
        "docs/interview/model-selection.md",
        "docs/architecture/14-source-code-walkthrough.md",
        "docs/architecture/decisions/0001-split-parser-and-normalizer.md"
      ]
    },
    {
      "name": "data-and-infrastructure",
      "code_patterns": [
        "app/infra/database*.py",
        "app/infra/minio_storage.py",
        "migrations/**"
      ],
      "documents": [
        "docs/architecture/07-data-and-infrastructure.md",
        "docs/postgresql-setup.md",
        "docs/reference/12-database-dictionary.md",
        "docs/architecture/decisions/0005-postgresql-and-minio-storage.md"
      ]
    },
    {
      "name": "api-ui-and-operations",
      "code_patterns": [
        "app/api/**",
        "app/main.py",
        "app/core/config.py",
        "app/services/auth_service.py",
        "app/services/runtime_status_service.py",
        "frontend/src/**",
        "scripts/**",
        "run_api.py",
        "run_extraction_worker.py",
        "start_local_demo.ps1",
        "stop_local_demo.ps1",
        ".env.example"
      ],
      "documents": [
        "docs/operations/08-api-ui-and-local-run.md",
        "docs/operations/13-error-codes-and-troubleshooting.md",
        "docs/reference/11-api-contracts.md",
        "docs/operations/review-workflow.md",
        "README.md"
      ]
    }
  ]
}
