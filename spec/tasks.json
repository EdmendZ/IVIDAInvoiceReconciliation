{
  "spec_version": "IR-SIMPLE-1.0.3",
  "execution": "strictly_sequential_fresh_sessions",
  "path_base": "repository_root",
  "deletes_allowed": false,
  "renames_allowed": false,
  "common_readonly": [
    "spec/"
  ],
  "universal_checks": [
    [
      "python",
      "tools/check_task_scope.py",
      "--task",
      "${TASK_ID}",
      "--base",
      "${TASK_BASE}",
      "--spec-root",
      "spec",
      "--evidence",
      "${FREEZE_RECORD}"
    ]
  ],
  "harness_acceptance": {
    "H01": "reject out-of-scope tracked/untracked/delete/rename paths",
    "H02": "reject traversal, symlink, junction and external path",
    "H03": "reject modified Spec, manifest or frozen checker",
    "H04": "failed candidate not merged; subsequent task not dispatched",
    "H05": "fresh session receives no predecessor conversation context",
    "H06": "diff-only mode explicitly declared; no Docker or filesystem isolation prerequisite"
  },
