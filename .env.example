APP_NAME=IVIDA Invoice Reconciliation
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8200
CORS_ORIGINS=http://localhost:5274

# 独立使用项目2当前的 MongoDB 服务，但使用新的数据库。
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ivida_invoice_reconciliation

# 独立使用项目2当前的 MinIO 服务，但使用新的 bucket。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=ivida-invoice-documents
MINIO_SECURE=false

# 模型供应商暂不锁定；阶段1先使用 deterministic 规则完成比对闭环。
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

