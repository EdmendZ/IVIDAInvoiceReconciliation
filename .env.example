APP_NAME=IVIDA Invoice Reconciliation
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8200
CORS_ORIGINS=http://localhost:5274
UPLOAD_MAX_BYTES=26214400
# Taptouch 机器对机器导入令牌；本地生成随机值，禁止提交真实令牌。
TAPTOUCH_INTEGRATION_TOKEN=

# PostgreSQL 作为业务主库。请修改主机、用户和密码。
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/ivida_invoice_reconciliation
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# 独立使用项目2当前的 MinIO 服务，但使用新的 bucket。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=ivida-invoice-documents
MINIO_SECURE=false

# 模型供应商暂不锁定；阶段1先使用 deterministic 规则完成比对闭环。
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# MinerU Precision API：请只把真实 token 写入被忽略的 .env。
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL=vlm
MINERU_LANGUAGE=en
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=5

# MinerU 文本结果结构化为 Invoice / Receive Note。
NORMALIZATION_BASE_URL=
NORMALIZATION_API_KEY=
NORMALIZATION_MODEL=
NORMALIZATION_TIMEOUT_SECONDS=120
# SDK 不做隐式重试；Worker 负责带审计的有限重试。
NORMALIZATION_MAX_RETRIES=0
# 结构化抽取不需要长思考，关闭可显著降低延迟和 Token。
NORMALIZATION_ENABLE_THINKING=false
# Leave empty for JSON mode. A hard cap can truncate a document mid-JSON.
NORMALIZATION_MAX_OUTPUT_TOKENS=
# 用于估算单据成本；不填写时成本字段保持为空。
NORMALIZATION_INPUT_COST_AUD_PER_MILLION=
NORMALIZATION_OUTPUT_COST_AUD_PER_MILLION=

# Worker 每隔 10 秒写入心跳；超过 30 秒未更新时 UI 显示离线。
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_OFFLINE_AFTER_SECONDS=30
