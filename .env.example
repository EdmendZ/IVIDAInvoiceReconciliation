APP_NAME=IVIDA Invoice Reconciliation
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8200
CORS_ORIGINS=http://localhost:5274
UPLOAD_MAX_BYTES=26214400

# PostgreSQL 作为业务主库。请修改主机、用户和密码。
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/ivida_invoice_reconciliation
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# 独立使用项目2当前的 MinIO 服务，但使用新的 bucket。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=ivida-invoice-documents
MINIO_SECURE=false

# 模型供应商暂不锁定；阶段1先使用 deterministic 规则完成比对闭环。
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
